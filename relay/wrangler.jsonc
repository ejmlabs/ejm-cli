{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ejm-cli-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "RELAY_ORIGIN": "https://relay.ejmlabs.com",
    "TERMS_VERSION": "preview-v1",
    "RETENTION_CONFIG": "{}",
    "ADMISSION_ENABLED": "false",
    "ADMISSION_LIMIT": "2",
    "PAID_DAILY_FRAMES": "50000",
    "PAID_DAILY_BYTES": "67108864",
    "COMMERCIAL_CONFIG": "{}",
    "PRIVACY_OPERATOR_ACCOUNT_IDS": ""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      },
      {
        "name": "ACCOUNT_QUOTA",
        "class_name": "AccountQuota"
      },
      {
        "name": "PRIVACY_AUTHORITY",
        "class_name": "PrivacyAuthority"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room",
        "AccountQuota",
        "PrivacyAuthority"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ejm-cli-relay",
      "database_id": "e42b7009-c485-4bad-86a7-b14036278ca6",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "account_id": "478a0db3a110d8503c16abbc1db27af4",
  "routes": [
    {
      "pattern": "relay.ejmlabs.com",
      "custom_domain": true
    }
  ],
  "limits": {
    "cpu_ms": 10,
    "subrequests": 50
  },
  "minify": true
}
